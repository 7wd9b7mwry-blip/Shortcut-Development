#define name Hevy Stats
// Hevy Stats — native Shortcuts actions (no JavaScript, no HTML).
//
// Input:  Hevy API key passed as Shortcut Input (never prompted).
// Output: ALWAYS a dictionary — either the stats result:
//           {"routineName": ..., "workingSetsPerMuscleGroup": {...},
//            "oneRepMaxKgPerExercise": {...}}
//         or a detailed error:
//           {"_error": ..., "_context": {"stage": ..., "detail": ...}}
// Error branches also show a notification with the specific message and
// relevant state. There are no silent failures.
//
// Stats mirror src/hevy-stats.js (kept as the tested spec):
//   - working sets: routine sets whose type is normal/failure/dropset
//     (warmup excluded), grouped by the exercise's primary muscle group
//     ("other" when the template lookup misses).
//   - 1RM: best Epley estimate (weight*(1+reps/30), true singles use the
//     weight itself) over history sets with weight > 0 and 1 <= reps <= 30,
//     rounded to 0.1 kg. Exercises without a qualifying set are omitted.
//   - the first routine returned by the API is treated as most recently
//     updated.
//
// IMPORTANT: bare truthiness checks (`if @x` / `if !@x`) are NOT used
// anywhere here. Device testing (Sep 30, 2026) showed they misbehave —
// an empty error message reached the error notification, which is only
// possible if the truthiness conditions evaluate incorrectly at runtime
// (inverted 100/101 "has any value" conditions, or empty strings counting
// as having a value). All emptiness checks use explicit `== @empty` / `!= @empty`
// comparisons and the error state uses a numeric flag.
//
// NOTE: Get Contents of URL halts the shortcut with a system error on HTTP
// or network failures (e.g. a wrong API key -> 401); Shortcuts offers no
// try/catch for that. Everything else is handled below.
//
// CHERRI GOTCHA (Sep 30, 2026 — cost a full device-test round trip):
// the `@dict['key']` subscript syntax SILENTLY compiles to a plain variable
// copy, dropping the key lookup entirely. ALWAYS use getValue(@dict, "key")
// (which correctly emits Get Dictionary Value), extracting to a temp var
// before text interpolation.

#include 'actions/web'
#include 'actions/text'
#include 'actions/math'
#define name HevyStats

@apiKey = "{ShortcutInput}"
// Numeric error flag (0 = ok, 1 = error). Never tested with truthiness.
@errFlag = 0
@errMsg = ""
@errDetail = ""
@errStage = ""
// Empty-text sentinel: Cherri only allows == / != between two variables.
@empty = ""
// Literal braces for hand-built JSON (single-quoted = raw, no interpolation).
@ob = '{'
@cb = '}'
// Working-set types, comma-padded so `contains` matches whole types only.
@okTypes = ",normal,failure,dropset,"

if @apiKey == @empty {
    @errFlag = 1
    @errStage = "read-input"
    @errMsg = "Missing API key"
    @errDetail = "Shortcut Input was empty. Pass your Hevy API key as the shortcut input."
}

// --- Fetch routines ---
if @errFlag == 0 {
    @routinesJson = downloadURL("https://api.hevyapp.com/v1/routines?page=1&pageSize=10", {"api-key": "{@apiKey}"})
    @routinesTxt = "{@routinesJson}"
    if @routinesTxt == @empty {
        @errFlag = 1
        @errStage = "fetch-routines"
        @errMsg = "Routines request returned no data"
        @errDetail = "GET /v1/routines came back empty. Check your network connection."
    }
}

// --- Parse routines ---
if @errFlag == 0 {
    @routinesDict = getDictionary(@routinesJson)
    @routinesList = getValue(@routinesDict, "routines")
    @nRoutines = count(@routinesList)
    if @nRoutines == 0 {
        @errFlag = 1
        @errStage = "parse-routines"
        @errMsg = "No usable routines in response"
        @errDetail = "The /v1/routines response had no routines list. Check that the API key is correct and Hevy Pro is active."
        @apiMsg = getValue(@routinesDict, "message")
        @apiMsgTxt = "{@apiMsg}"
        if @apiMsgTxt != @empty {
            @errDetail = "The Hevy API itself reported an error: {@apiMsgTxt}"
        }
    }
}
if @errFlag == 0 {
    @routine = getFirstItem(@routinesList)
    @routineDict = getDictionary(@routine)
    @routineTitle = getValue(@routineDict, "title")
    @routineName = "{@routineTitle}"
    if @routineName == @empty {
        @errFlag = 1
        @errStage = "parse-routines"
        @errMsg = "First routine has no title"
        @errDetail = "The most recently updated routine has no usable 'title'."
    }
}

// --- Per-exercise: working sets + best Epley 1RM ---
// Muscle groups come from the single-template endpoint
// (GET /v1/exercise_templates/{id}), one tiny call per exercise, so a
// template is never missed because it fell past page 1 of the catalogue.
if @errFlag == 0 {
    @exercises = getValue(@routineDict, "exercises")
    @wsDict = {}
    @muscleOrder = ""
    @wsSep = ""
    @wsEntries = ""
    @wsESep = ""
    @rmJson = ""
    @rmSep = ""
    @seenTids = "|"

    for ex in @exercises {
        @exDict = getDictionary(@ex)
        @tidVal = getValue(@exDict, "exercise_template_id")
        @tid = "{@tidVal}"

        // Primary muscle group via the single-template endpoint.
        // One tiny call per exercise — never misses a template that sits
        // past page 1 of the catalogue. "other" when the fetch misses.
        @muscle = "other"
        if @tid != @empty {
            @tplJson = downloadURL("https://api.hevyapp.com/v1/exercise_templates/{@tid}", {"api-key": "{@apiKey}"})
            @tplTxt = "{@tplJson}"
            if @tplTxt != @empty {
                @tplDict = getDictionary(@tplJson)
                @pmgVal = getValue(@tplDict, "primary_muscle_group")
                @pmg = "{@pmgVal}"
                if @pmg != @empty {
                    @muscle = @pmg
                }
            }
        }

        // Working sets prescribed in the routine (warmup excluded).
        // Counted for EVERY occurrence, even duplicate exercises.
        @sets = getValue(@exDict, "sets")
        @wsCount = 0
        for s in @sets {
            @sDict = getDictionary(@s)
            @stypeVal = getValue(@sDict, "type")
            @stype = "{@stypeVal}"
            if @okTypes contains ",{@stype}," {
                @wsCount = @wsCount + 1
            }
        }
        @curVal = getValue(@wsDict, @muscle)
        @curTxt = "{@curVal}"
        if @curTxt == @empty {
            @curNum = 0
            @muscleOrder = "{@muscleOrder}{@wsSep}{@muscle}"
            @wsSep = ","
        } else {
            @curNum = number(@curTxt)
        }
        @newCount = @curNum + @wsCount
        @wsDict = setValue(@wsDict, @muscle, "{@newCount}")

        // Best Epley 1RM from this exercise's history.
        // History is fetched once per template id (deduplicated).
        @dup = 0
        if @tid != @empty {
            if @seenTids contains "|{@tid}|" {
                @dup = 1
            } else {
                @seenTids = "{@seenTids}{@tid}|"
            }
        }
        if @dup == 0 {
            if @tid != @empty {
                @best = 0
                @historyJson = downloadURL("https://api.hevyapp.com/v1/exercise_history/{@tid}?page=1&pageSize=100", {"api-key": "{@apiKey}"})
                @historyTxt = "{@historyJson}"
                if @historyTxt != @empty {
                    @historyDict = getDictionary(@historyJson)
                    @entries = getValue(@historyDict, "exercise_history")
                    for e in @entries {
                        @eDict = getDictionary(@e)
                        @wVal = getValue(@eDict, "weight_kg")
                        @wTxt = "{@wVal}"
                        @rVal = getValue(@eDict, "reps")
                        @rTxt = "{@rVal}"
                        @hTypeVal = getValue(@eDict, "set_type")
                        @hType = "{@hTypeVal}"
                        if @okTypes contains ",{@hType}," {
                            // number() fails on empty text on-device (e.g.
                            // bodyweight history has null weight_kg), so it
                            // is only called on non-empty text; missing ->
                            // 0, which the > 0 / >= 1 guards then skip.
                            @wNum = 0
                            if @wTxt != @empty {
                                @wNum = number(@wTxt)
                            }
                            @rNum = 0
                            if @rTxt != @empty {
                                @rNum = number(@rTxt)
                            }
                            if @wNum > 0 {
                                if @rNum >= 1 {
                                    if @rNum <= 30 {
                                        if @rNum == 1 {
                                            // "* 1" keeps the number type: a bare
                                            // "@est = @wNum" copy loses it in Cherri.
                                            @est = @wNum * 1
                                        } else {
                                            @est = @wNum * (1 + @rNum / 30)
                                        }
                                        if @est > @best {
                                            @best = @est
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if @best > 0 {
                    @bestR = round(@best, "Tenths")
                    @titleVal = getValue(@exDict, "title")
                    @title = "{@titleVal}"
                    if @title == @empty {
                        @title = @tid
                    }
                    @safeTitle = replaceText("\\", "\\\\", @title)
                    @safeTitle = replaceText("\"", "\\\"", @safeTitle)
                    @rmJson = "{@rmJson}{@rmSep}\"{@safeTitle}\": {@bestR}"
                    @rmSep = ", "
                }
            }
        }
    }

    // Working-sets entries, in first-seen muscle order.
    // (splitText on an empty string yields nothing usable; the inner
    // `!= ""` guard skips it, so no outer emptiness check is needed.)
    @muscleList = splitText(@muscleOrder, ",")
    for m in @muscleList {
        if @m != @empty {
            @mCount = getValue(@wsDict, @m)
            @safeMuscle = replaceText("\\", "\\\\", @m)
            @safeMuscle = replaceText("\"", "\\\"", @safeMuscle)
            @wsEntries = "{@wsEntries}{@wsESep}\"{@safeMuscle}\": {@mCount}"
            @wsESep = ", "
        }
    }

    @safeRoutineName = replaceText("\\", "\\\\", @routineName)
    @safeRoutineName = replaceText("\"", "\\\"", @safeRoutineName)
    @resultJson = "{@ob}\"routineName\": \"{@safeRoutineName}\", \"workingSetsPerMuscleGroup\": {@ob}{@wsEntries}{@cb}, \"oneRepMaxKgPerExercise\": {@ob}{@rmJson}{@cb}{@cb}"
}

// --- Error payload (built always; used only on the error branch) ---
@safeErrMsg = replaceText("\\", "\\\\", @errMsg)
@safeErrMsg = replaceText("\"", "\\\"", @safeErrMsg)
@safeErrDetail = replaceText("\\", "\\\\", @errDetail)
@safeErrDetail = replaceText("\"", "\\\"", @safeErrDetail)
@errJson = "{@ob}\"_error\": \"{@safeErrMsg}\", \"_context\": {@ob}\"stage\": \"{@errStage}\", \"detail\": \"{@safeErrDetail}\" {@cb}{@cb}"

// --- Output: always a dictionary ---
// Two separate explicit checks (no else, no truthiness): exactly one runs.
// NOTE: `show()` is Show Result — the only way a manually-run shortcut
// displays anything. The success branch MUST show, otherwise a good run
// ends with no visible response (found by device testing, Sep 30 2026).
if @errFlag == 1 {
    show("Hevy Stats error: {@errMsg} ({@errDetail})")
    @finalJson = @errJson
}
if @errFlag == 0 {
    @finalJson = @resultJson
    show("{@finalJson}")
}
@finalResult = getDictionary(@finalJson)
@finalTxt = "{@finalJson}"
if @finalTxt == @empty {
    show("Hevy Stats: internal error, empty result (this should never happen).")
}
