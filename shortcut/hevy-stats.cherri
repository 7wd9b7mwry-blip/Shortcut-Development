#define name Hevy Stats
// Hevy Stats — native Shortcuts actions (no JavaScript, no HTML).
//
// Input:  Shortcut Input is either your Hevy API key as plain text, or a
//         JSON dictionary / Dictionary {"api_key": "...", "body_weight_kg": 70}.
//         body_weight_kg is optional; when absent the latest Hevy body
//         measurement is used, else bodyweight sets get no weight metrics.
// Output: ALWAYS a dictionary:
//           {"routineName": ..., "workingSetsPerMuscleGroup": {...},
//            "volumeKgPerExercise": {...}, "volumeKgPerMuscleGroup": {...},
//            "oneRepMaxKgPerExercise": {...}, "bodyWeightKgUsed": 70 | null,
//            "routineWorkingSets": 12, "routineVolumeKg": 2552.5,
//            "routineDurationMinutes": 45.5 | null}
//   routineWorkingSets: total working sets prescribed in the routine.
//   routineVolumeKg: sum of the rounded per-exercise volumes.
//   routineDurationMinutes: end-start of the latest history workout whose
//     workout_title matches the routine title (minutes, 0.1); null when
//     no such workout has both timestamps.
// Error branches return a detailed error:
//           {"_error": ..., "_context": {"stage": ..., "detail": ...}}
// Error branches also show a notification with the specific message and
// relevant state. There are no silent failures.
//
// Stats mirror src/hevy-stats.js (kept as the tested spec):
//   - working sets: routine sets whose type is normal/failure/dropset
//     (warmup excluded), grouped by the exercise's primary muscle group
//     ("other" when the template lookup misses).
//   - effective weight per history set: logged weight_kg when > 0, else the
//     body weight for bodyweight sets (weight_kg null/0) when known.
//   - 1RM: best Epley estimate (weight*(1+reps/30), true singles use the
//     weight itself) over qualifying history sets, rounded to 0.1 kg.
//     Exercises without a qualifying set are omitted.
//   - volume: sum of effective-weight x reps over the same qualifying sets
//     from the fetched history, per exercise and per muscle group,
//     rounded to 0.1 kg. Exercises with no volume are omitted.
//   - qualifying set: type normal/failure/dropset (warmup excluded),
//     effective weight > 0, reps 1..30.
//   - routineWorkingSets: total working sets prescribed in the routine
//     (every occurrence counts, same population as the per-muscle map).
//   - routineVolumeKg: sum of the rounded per-exercise volumes.
//   - routineDurationMinutes: minutes between start and end of the history
//     workout with the max workout_start_time whose workout_title matches
//     the routine title; null when none has both timestamps.
//   - body weight precedence: explicit body_weight_kg input > latest Hevy
//     body measurement with a weight > 0 > unknown.
//   - the first routine returned by the API is treated as most recently
//     updated.
//
// IMPORTANT: bare truthiness checks (`if @x` / `if !@x`) are NOT used
// anywhere here. Device testing (Sep 30, 2026) showed they misbehave —
// an empty error message reached the error notification, which is only
// possible if the truthiness conditions evaluate incorrectly at runtime
// (inverted 100/101 "has any value" conditions, or empty strings counting
// as having a value). All emptiness checks use explicit `== @empty` / `!= @empty`
// comparisons and the error state uses a numeric flag.
//
// NOTE: Get Contents of URL halts the shortcut with a system error on HTTP
// or network failures (e.g. a wrong API key -> 401); Shortcuts offers no
// try/catch for that. Everything else is handled below.
//
// CHERRI GOTCHA (Sep 30, 2026 — cost a full device-test round trip):
// the `@dict['key']` subscript syntax SILENTLY compiles to a plain variable
// copy, dropping the key lookup entirely. ALWAYS use getValue(@dict, "key")
// (which correctly emits Get Dictionary Value), extracting to a temp var
// before text interpolation.

#include 'actions/web'
#include 'actions/text'
#include 'actions/math'
#include 'actions/calendar'

// Raw Shortcuts action: Get Time Between Dates
// (is.workflow.actions.gettimebetweendates). Cherri 2.3.0 has no built-in
// for it; the schema below is verified against Apple's action definition
// (WFInput = second date, WFTimeUntilFromDate = first date, output =
// WFInput - WFTimeUntilFromDate) and against Daniel's own Stopwatch
// shortcut, which uses the same action. Unit is pinned to Minutes
// explicitly (the action default) rather than relied upon.
action 'is.workflow.actions.gettimebetweendates' timeBetweenDates(variable from: 'WFTimeUntilFromDate', variable to: 'WFInput'): number {
    "WFTimeUntilUnit": "Minutes"
}
#define name HevyStats

@inputTxt = "{ShortcutInput}"
@apiKey = ""
@bodyWeightTxt = ""
// Input shapes: plain API key text (backwards compatible), JSON dictionary
// text {"api_key": "...", "body_weight_kg": 70}, or a real Dictionary object
// (which coerces to plist-style text: api_key = "UUID";). The quoted-key
// check keeps getDictionary away from plain key text.
if @inputTxt contains "\"api_key\"" {
    @inputDict = getDictionary(@inputTxt)
    @keyVal = getValue(@inputDict, "api_key")
    @apiKey = "{@keyVal}"
    @bwVal = getValue(@inputDict, "body_weight_kg")
    @bodyWeightTxt = "{@bwVal}"
} else {
    if @inputTxt contains "api_key" {
        // Plist-style dictionary text: api_key = "UUID"; body_weight_kg = 70;
        @kpParts = splitText(@inputTxt, "api_key = \"")
        @kpTail = getLastItem(@kpParts)
        @kpTailTxt = "{@kpTail}"
        @kvParts = splitText(@kpTailTxt, "\"")
        @apiKey = getFirstItem(@kvParts)
        if @inputTxt contains "body_weight_kg" {
            @wpParts = splitText(@inputTxt, "body_weight_kg = ")
            @wpTail = getLastItem(@wpParts)
            @wpTailTxt = "{@wpTail}"
            @wpNoQuotes = replaceText("\"", "", @wpTailTxt)
            @wvParts = splitText(@wpNoQuotes, ";")
            @bodyWeightTxt = getFirstItem(@wvParts)
        }
    } else {
        if @inputTxt contains "{" {
            // Dict-shaped but no api_key: leave @apiKey empty so the
            // missing-key error below fires (a no-op assignment keeps
            // the branch non-empty for the compiler).
            @apiKey = ""
        } else {
            @apiKey = @inputTxt
        }
    }
}
// getFirstItem/getLastItem return untyped variables; coerce to text for the
// type checker (same pattern as downloadURL/getValue outputs elsewhere).
@apiKey = "{@apiKey}"
@bodyWeightTxt = "{@bodyWeightTxt}"
// Numeric error flag (0 = ok, 1 = error). Never tested with truthiness.
@errFlag = 0
@errMsg = ""
@errDetail = ""
@errStage = ""
// Empty-text sentinel: Cherri only allows == / != between two variables.
@empty = ""
// Literal braces for hand-built JSON (single-quoted = raw, no interpolation).
@ob = '{'
@cb = '}'
// Working-set types, comma-padded so `contains` matches whole types only.
@okTypes = ",normal,failure,dropset,"
if @apiKey == @empty {
    @errFlag = 1
    @errStage = "read-input"
    @errMsg = "Missing API key"
    @errDetail = 'Shortcut Input was empty, or the input dictionary had no api_key. Pass your Hevy API key as the shortcut input, or a JSON dictionary {"api_key": "...", "body_weight_kg": 70}.'
}

// --- Fetch routines ---
if @errFlag == 0 {
    @routinesJson = downloadURL("https://api.hevyapp.com/v1/routines?page=1&pageSize=10", {"api-key": "{@apiKey}"})
    @routinesTxt = "{@routinesJson}"
    if @routinesTxt == @empty {
        @errFlag = 1
        @errStage = "fetch-routines"
        @errMsg = "Routines request returned no data"
        @errDetail = "GET /v1/routines came back empty. Check your network connection."
    }
}

// --- Parse routines ---
if @errFlag == 0 {
    @routinesDict = getDictionary(@routinesJson)
    @routinesList = getValue(@routinesDict, "routines")
    @nRoutines = count(@routinesList)
    if @nRoutines == 0 {
        @errFlag = 1
        @errStage = "parse-routines"
        @errMsg = "No usable routines in response"
        @errDetail = "The /v1/routines response had no routines list. Check that the API key is correct and Hevy Pro is active."
        @apiMsg = getValue(@routinesDict, "message")
        @apiMsgTxt = "{@apiMsg}"
        if @apiMsgTxt != @empty {
            @errDetail = "The Hevy API itself reported an error: {@apiMsgTxt}"
        }
    }
}
if @errFlag == 0 {
    @routine = getFirstItem(@routinesList)
    @routineDict = getDictionary(@routine)
    @routineTitle = getValue(@routineDict, "title")
    @routineName = "{@routineTitle}"
    if @routineName == @empty {
        @errFlag = 1
        @errStage = "parse-routines"
        @errMsg = "First routine has no title"
        @errDetail = "The most recently updated routine has no usable 'title'."
    }
}

// --- Body weight (for bodyweight history sets) ---
// Precedence: explicit body_weight_kg input > latest Hevy body measurement
// with weight > 0 > unknown (0). Measurements are newest-first; the first
// entry carrying a positive weight wins. A miss is tolerated, never an
// error: bodyweight sets then simply get no weight-based metrics.
@bodyWeightNum = 0
if @errFlag == 0 {
    if @bodyWeightTxt != @empty {
        @bodyWeightNum = number(@bodyWeightTxt)
    }
}
if @errFlag == 0 {
    if @bodyWeightNum == 0 {
        @bmJson = downloadURL("https://api.hevyapp.com/v1/body_measurements?page=1&pageSize=10", {"api-key": "{@apiKey}"})
        @bmTxt = "{@bmJson}"
        if @bmTxt != @empty {
            @bmDict = getDictionary(@bmJson)
            @bms = getValue(@bmDict, "body_measurements")
            for bm in @bms {
                if @bodyWeightNum == 0 {
                    @bmEntry = getDictionary(@bm)
                    @bmwVal = getValue(@bmEntry, "weight_kg")
                    @bmwTxt = "{@bmwVal}"
                    if @bmwTxt != @empty {
                        @bmwNum = number(@bmwTxt)
                        if @bmwNum > 0 {
                            @bodyWeightNum = @bmwNum
                        }
                    }
                }
            }
        }
    }
}

// --- Per-exercise: working sets + best Epley 1RM ---
// Muscle groups come from the single-template endpoint
// (GET /v1/exercise_templates/{id}), one tiny call per exercise, so a
// template is never missed because it fell past page 1 of the catalogue.
if @errFlag == 0 {
    @exercises = getValue(@routineDict, "exercises")
    @wsDict = {}
    @muscleOrder = ""
    @wsSep = ""
    @wsEntries = ""
    @wsESep = ""
    @rmJson = ""
    @rmSep = ""
    @volExJson = ""
    @volExSep = ""
    @volDict = {}
    @volMuscleOrder = ""
    @volMSep = ""
    @volMuscleJson = ""
    @volMuscleSep = ""
    @seenTids = "|"
    @totalWs = 0
    @totalVol = 0
    // Latest workout of this routine (for routineDurationMinutes): the
    // max workout_start_time among history entries whose workout_title
    // matches the routine title, compared as parsed dates.
    @latestStart = ""
    @latestEnd = ""

    for ex in @exercises {
        @exDict = getDictionary(@ex)
        @tidVal = getValue(@exDict, "exercise_template_id")
        @tid = "{@tidVal}"

        // Primary muscle group via the single-template endpoint.
        // One tiny call per exercise — never misses a template that sits
        // past page 1 of the catalogue. "other" when the fetch misses.
        @muscle = "other"
        if @tid != @empty {
            @tplJson = downloadURL("https://api.hevyapp.com/v1/exercise_templates/{@tid}", {"api-key": "{@apiKey}"})
            @tplTxt = "{@tplJson}"
            if @tplTxt != @empty {
                @tplDict = getDictionary(@tplJson)
                @pmgVal = getValue(@tplDict, "primary_muscle_group")
                @pmg = "{@pmgVal}"
                if @pmg != @empty {
                    @muscle = @pmg
                }
            }
        }

        // Working sets prescribed in the routine (warmup excluded).
        // Counted for EVERY occurrence, even duplicate exercises.
        @sets = getValue(@exDict, "sets")
        @wsCount = 0
        for s in @sets {
            @sDict = getDictionary(@s)
            @stypeVal = getValue(@sDict, "type")
            @stype = "{@stypeVal}"
            if @okTypes contains ",{@stype}," {
                @wsCount = @wsCount + 1
            }
        }
        @curVal = getValue(@wsDict, @muscle)
        @curTxt = "{@curVal}"
        if @curTxt == @empty {
            @curNum = 0
            @muscleOrder = "{@muscleOrder}{@wsSep}{@muscle}"
            @wsSep = ","
        } else {
            @curNum = number(@curTxt)
        }
        @newCount = @curNum + @wsCount
        @wsDict = setValue(@wsDict, @muscle, "{@newCount}")
        // Routine total: every occurrence counts, same as the per-muscle map.
        @totalWs = @totalWs + @wsCount

        // Best Epley 1RM from this exercise's history.
        // History is fetched once per template id (deduplicated).
        @dup = 0
        if @tid != @empty {
            if @seenTids contains "|{@tid}|" {
                @dup = 1
            } else {
                @seenTids = "{@seenTids}{@tid}|"
            }
        }
        if @dup == 0 {
            if @tid != @empty {
                @best = 0
                @vol = 0
                @historyJson = downloadURL("https://api.hevyapp.com/v1/exercise_history/{@tid}?page=1&pageSize=100", {"api-key": "{@apiKey}"})
                @historyTxt = "{@historyJson}"
                if @historyTxt != @empty {
                    @historyDict = getDictionary(@historyJson)
                    @entries = getValue(@historyDict, "exercise_history")
                    for e in @entries {
                        @eDict = getDictionary(@e)
                        @wVal = getValue(@eDict, "weight_kg")
                        @wTxt = "{@wVal}"
                        @rVal = getValue(@eDict, "reps")
                        @rTxt = "{@rVal}"
                        @hTypeVal = getValue(@eDict, "set_type")
                        @hType = "{@hTypeVal}"
                        // Latest-workout tracking for routineDurationMinutes.
                        // Only entries from a workout titled like this
                        // routine, with both timestamps present.
                        @wtVal = getValue(@eDict, "workout_title")
                        @wt = "{@wtVal}"
                        @wStartVal = getValue(@eDict, "workout_start_time")
                        @wStart = "{@wStartVal}"
                        @wEndVal = getValue(@eDict, "workout_end_time")
                        @wEnd = "{@wEndVal}"
                        if @wt == @routineName {
                            if @wStart != @empty {
                                if @wEnd != @empty {
                                    if @latestStart == @empty {
                                        @latestStart = @wStart
                                        @latestEnd = @wEnd
                                    } else {
                                        // Cherri only allows > on dates, not
                                        // text; comparing parsed dates is
                                        // also robust to timestamp formats.
                                        @dWS = date(@wStart)
                                        @dLatest = date(@latestStart)
                                        if @dWS > @dLatest {
                                            @latestStart = @wStart
                                            @latestEnd = @wEnd
                                        }
                                    }
                                }
                            }
                        }
                        if @okTypes contains ",{@hType}," {
                            // number() fails on empty text on-device (e.g.
                            // bodyweight history has null weight_kg), so it
                            // is only called on non-empty text; missing ->
                            // 0, which the > 0 / >= 1 guards then skip.
                            @wNum = 0
                            if @wTxt != @empty {
                                @wNum = number(@wTxt)
                            }
                            @rNum = 0
                            if @rTxt != @empty {
                                @rNum = number(@rTxt)
                            }
                            // Effective weight: logged weight when > 0, else
                            // the body weight for bodyweight sets (null/0
                            // weight_kg) when known, else 0 (skipped).
                            @effW = 0
                            if @wNum > 0 {
                                @effW = @wNum
                            } else {
                                if @bodyWeightNum > 0 {
                                    @effW = @bodyWeightNum
                                }
                            }
                            if @effW > 0 {
                                if @rNum >= 1 {
                                    if @rNum <= 30 {
                                        if @rNum == 1 {
                                            // "* 1" keeps the number type: a bare
                                            // "@est = @wNum" copy loses it in Cherri.
                                            @est = @effW * 1
                                        } else {
                                            @est = @effW * (1 + @rNum / 30)
                                        }
                                        if @est > @best {
                                            @best = @est
                                        }
                                        @vol = @vol + @effW * @rNum
                                    }
                                }
                            }
                        }
                    }
                }
                @titleVal = getValue(@exDict, "title")
                @title = "{@titleVal}"
                if @title == @empty {
                    @title = @tid
                }
                @safeTitle = replaceText("\\", "\\\\", @title)
                @safeTitle = replaceText("\"", "\\\"", @safeTitle)
                if @best > 0 {
                    @bestR = round(@best, "Tenths")
                    @rmJson = "{@rmJson}{@rmSep}\"{@safeTitle}\": {@bestR}"
                    @rmSep = ", "
                }
                if @vol > 0 {
                    @volR = round(@vol, "Tenths")
                    @volExJson = "{@volExJson}{@volExSep}\"{@safeTitle}\": {@volR}"
                    @volExSep = ", "
                    // Routine total: sum of the rounded per-exercise
                    // volumes (rounded after each add, mirroring the JS).
                    @totalVolSum = @totalVol + @volR
                    @totalVol = round(@totalVolSum, "Tenths")
                    // Per-muscle-group volume, in first-seen muscle order.
                    @curVolVal = getValue(@volDict, @muscle)
                    @curVolTxt = "{@curVolVal}"
                    if @curVolTxt == @empty {
                        @curVolNum = 0
                        @volMuscleOrder = "{@volMuscleOrder}{@volMSep}{@muscle}"
                        @volMSep = ","
                    } else {
                        @curVolNum = number(@curVolTxt)
                    }
                    @newVolSum = @curVolNum + @volR
                    @newVol = round(@newVolSum, "Tenths")
                    @volDict = setValue(@volDict, @muscle, "{@newVol}")
                }
            }
        }
    }

    // Routine duration: minutes between the latest workout's start and
    // end (timeBetweenDates = WFInput - WFTimeUntilFromDate, in Minutes).
    // Null when no title-matching workout had both timestamps, or the
    // data is bad (negative span).
    @durMinJson = "null"
    if @latestStart != @empty {
        @dStart = date(@latestStart)
        @dEnd = date(@latestEnd)
        @durMin = timeBetweenDates(@dStart, @dEnd)
        if @durMin >= 0 {
            @durMinR = round(@durMin, "Tenths")
            @durMinJson = "{@durMinR}"
        }
    }

    // Working-sets entries, in first-seen muscle order.
    // (splitText on an empty string yields nothing usable; the inner
    // `!= ""` guard skips it, so no outer emptiness check is needed.)
    @muscleList = splitText(@muscleOrder, ",")
    for m in @muscleList {
        if @m != @empty {
            @mCount = getValue(@wsDict, @m)
            @safeMuscle = replaceText("\\", "\\\\", @m)
            @safeMuscle = replaceText("\"", "\\\"", @safeMuscle)
            @wsEntries = "{@wsEntries}{@wsESep}\"{@safeMuscle}\": {@mCount}"
            @wsESep = ", "
        }
    }

    // Volume-per-muscle entries, in first-seen muscle order.
    @volMuscleList = splitText(@volMuscleOrder, ",")
    for vm in @volMuscleList {
        if @vm != @empty {
            @vmVol = getValue(@volDict, @vm)
            @safeVM = replaceText("\\", "\\\\", @vm)
            @safeVM = replaceText("\"", "\\\"", @safeVM)
            @volMuscleJson = "{@volMuscleJson}{@volMuscleSep}\"{@safeVM}\": {@vmVol}"
            @volMuscleSep = ", "
        }
    }

    @safeRoutineName = replaceText("\\", "\\\\", @routineName)
    @safeRoutineName = replaceText("\"", "\\\"", @safeRoutineName)
    @bwJsonVal = "null"
    if @bodyWeightNum > 0 {
        @bwJsonVal = "{@bodyWeightNum}"
    }
    @resultJson = "{@ob}\"routineName\": \"{@safeRoutineName}\", \"workingSetsPerMuscleGroup\": {@ob}{@wsEntries}{@cb}, \"volumeKgPerExercise\": {@ob}{@volExJson}{@cb}, \"volumeKgPerMuscleGroup\": {@ob}{@volMuscleJson}{@cb}, \"oneRepMaxKgPerExercise\": {@ob}{@rmJson}{@cb}, \"bodyWeightKgUsed\": {@bwJsonVal}, \"routineWorkingSets\": {@totalWs}, \"routineVolumeKg\": {@totalVol}, \"routineDurationMinutes\": {@durMinJson}{@cb}"
}

// --- Error payload (built always; used only on the error branch) ---
@safeErrMsg = replaceText("\\", "\\\\", @errMsg)
@safeErrMsg = replaceText("\"", "\\\"", @safeErrMsg)
@safeErrDetail = replaceText("\\", "\\\\", @errDetail)
@safeErrDetail = replaceText("\"", "\\\"", @safeErrDetail)
@errJson = "{@ob}\"_error\": \"{@safeErrMsg}\", \"_context\": {@ob}\"stage\": \"{@errStage}\", \"detail\": \"{@safeErrDetail}\" {@cb}{@cb}"

// --- Output: always a dictionary ---
// Two separate explicit checks (no else, no truthiness): exactly one runs.
// NOTE: `show()` is Show Result — the only way a manually-run shortcut
// displays anything. The success branch MUST show, otherwise a good run
// ends with no visible response (found by device testing, Sep 30 2026).
if @errFlag == 1 {
    show("Hevy Stats error: {@errMsg} ({@errDetail})")
    @finalJson = @errJson
}
if @errFlag == 0 {
    @finalJson = @resultJson
    show("{@finalJson}")
}
@finalTxt = "{@finalJson}"
if @finalTxt == @empty {
    show("Hevy Stats: internal error, empty result (this should never happen).")
}
// The shortcut's output is its last action's output: always the result or
// error dictionary. This assignment MUST stay the final action (no trailing
// no-op If): Hevy Record Metrics calls this shortcut with Run Shortcut and
// relies on receiving a Dictionary.
@finalResult = getDictionary(@finalJson)
