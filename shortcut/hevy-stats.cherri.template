// Hevy Stats — Cherri I/O shell.
//
// This file is a TEMPLATE. build/build.py:
//   1. replaces __HEVY_STATS_JS_B64__ with the base64 of src/hevy-stats.js,
//   2. compiles it with Cherri,
//   3. sets WFWorkflowHasShortcutInputVariables so iOS knows the shortcut
//      accepts input (the Hevy API key is passed as Shortcut Input).
//
// The shortcut fetches the user's most recently updated Hevy routine, its
// exercise templates (for muscle groups), and each exercise's full history
// (for estimated 1RM), then hands plain data fragments to the embedded
// JavaScript core, which computes the stats. All analysis semantics live in
// src/hevy-stats.js; this file only does I/O and fragment extraction.
//
// The Hevy API key is taken from Shortcut Input (not prompted).
#include 'actions/web'
#include 'actions/text'
#include 'actions/crypto'
#define name HevyStats

// --- 1. Fetch routines (most recently updated first) ---
@routinesResp = downloadURL("https://api.hevyapp.com/v1/routines?page=1&pageSize=10", {"api-key": "{ShortcutInput}"})
@routines = @routinesResp['routines']
@routineCount = count(@routines)
if @routineCount == 0 {
    show("Hevy API request failed. Check that your API key is correct and Hevy Pro is active (find the key in the Hevy app under Settings).")
    stop()
}
@routine = getListItem(@routines, 1)
@routineName = @routine['title']
@routineNameEnc = urlEncode("{@routineName}")
@routineExercises = @routine['exercises']

// --- 2. Routine-exercise fragments: ["templateId","urlEncodedTitle",["type",...]] ---
@routineFrag = ""
for ex in @routineExercises {
    @exTid = @ex['exercise_template_id']
    @exTitle = @ex['title']
    @exTitleEnc = urlEncode("{@exTitle}")
    @exSets = @ex['sets']
    @typesText = ""
    for s in @exSets {
        @sType = @s['type']
        @typesText = "{@typesText}\"{@sType}\","
    }
    @routineFrag = "{@routineFrag}[\"{@exTid}\",\"{@exTitleEnc}\",[{@typesText}]],"
}

// --- 3. Exercise history per routine exercise (for estimated 1RM) ---
// Fragments: ["templateId","weightKg","reps","setType",]. All values are
// passed as strings; the JS core parses them with parseFloat/parseInt, so
// null or missing weight/reps (interpolated as empty) safely become NaN and
// are excluded by the qualification rules there.
@historyFrag = ""
for ex2 in @routineExercises {
    @ex2Tid = @ex2['exercise_template_id']
    @histResp = downloadURL("https://api.hevyapp.com/v1/exercise_history/{@ex2Tid}?page=1&pageSize=100", {"api-key": "{ShortcutInput}"})
    @entries = @histResp['exercise_history']
    for e in @entries {
        @ew = @e['weight_kg']
        @er = @e['reps']
        @est = @e['set_type']
        @historyFrag = "{@historyFrag}[\"{@ex2Tid}\",\"{@ew}\",\"{@er}\",\"{@est}\"],"
    }
}

// --- 4. Exercise templates (template ID -> primary muscle group) ---
@templatesResp = downloadURL("https://api.hevyapp.com/v1/exercise_templates?page=1&pageSize=100", {"api-key": "{ShortcutInput}"})
@templates = @templatesResp['exercise_templates']
@templatesFrag = ""
for t in @templates {
    @tId = @t['id']
    @tMuscle = @t['primary_muscle_group']
    @templatesFrag = "{@templatesFrag}[\"{@tId}\",\"{@tMuscle}\"],"
}

// --- 5. Build the data-URL page and run the JS core in it ---
@jsB64 = "__HEVY_STATS_JS_B64__"
@js = base64Decode(@jsB64)
@page = "<html><head><meta charset=utf-8></head><body><script>{@js}</script></body></html>"
@page = replaceText("__ROUTINE_NAME__", @routineNameEnc, @page)
@page = replaceText("__ROUTINE_EXERCISES__", @routineFrag, @page)
@page = replaceText("__TEMPLATES__", @templatesFrag, @page)
@page = replaceText("__HISTORY_ENTRIES__", @historyFrag, @page)
@pageB64 = base64Encode(@page)
@pageUrl = "data:text/html;charset=utf-8;base64,{@pageB64}"
@rich = getRichTextFromHTML("{@pageUrl.richtext}")
@decoded = urlDecode(@rich)
@result = getDictionary(@decoded)
