// Hevy Record Metrics.
//
// Runs the Hevy Stats shortcut (input passed through UNCHANGED: plain API
// key text or a {"api_key": ..., "body_weight_kg": ...} dictionary) and
// converts its result into a LIST of RecordMetric dictionaries in the shape
// of the "Record Metrics" form (see docs/RECORD_METRIC.md):
//
//   {"Form Name": "Hevy - Muscle Group" | "Hevy - Exercise" | "Hevy - Routine",
//    "Metric Name": "<muscle group|exercise|routine> <metric>",
//    "Set Value": <number from Hevy Stats>,
//    "Increment": false, "Decrement": false, "Reset": false,
//    "Increment Amount": ""}
//
// Metric records produced:
//   - per muscle group: "<muscle> working sets", "<muscle> volume"
//   - per exercise:     "<exercise> volume", "<exercise> 1RM"
//   - routine:          "<routine> working sets", "<routine> volume",
//                       "<routine> duration" (skipped when Hevy Stats
//                       reports no duration)
//
// The list is built as JSON text (so Increment/Decrement/Reset are REAL
// booleans and Set Value is a REAL number — setValue() only stores text)
// and parsed with getDictionary into a real List of Dictionaries.
//
// If Hevy Stats returns a handled error ({"_error": ..., "_context": ...}),
// NO metric records are fabricated: the error dictionary is passed through
// as this shortcut's result.
//
// Output: ALWAYS a list of RecordMetric dictionaries, or the handled-error
// dictionary from Hevy Stats.
//
// NOTE: the Run Shortcut action below references Hevy Stats by the name it
// is installed under. If you renamed it on your iPhone, update
// @hevyStatsName.

#define name HevyRecordMetrics

#include 'actions/text'
#include 'actions/shortcuts'

// Get Value for Key with a VARIABLE key on a variable-typed dictionary.
// Same underlying action Cherri's getValue() emits
// (is.workflow.actions.getvalueforkey); declared raw because Cherri's
// type checker only accepts getValue() on dictionary-typed variables,
// while sub-dictionaries pulled out of another dictionary arrive untyped.
action 'is.workflow.actions.getvalueforkey' dictVal(variable dict: 'WFInput', text key: 'WFDictionaryKey'): variable {
    "WFGetDictionaryValueType": "Value"
}

// Get Keys from Dictionary on a variable-typed dictionary. Same underlying
// action Cherri's getKeys() emits (is.workflow.actions.getvalueforkey with
// "All Keys"); declared raw for the same type-checker reason as dictVal.
action 'is.workflow.actions.getvalueforkey' dictKeys(variable dict: 'WFInput'): array {
    "WFGetDictionaryValueType": "All Keys"
}

// Name of the Hevy Stats shortcut as installed on this iPhone
// ("Hevy Stats", with the space). Update this if you renamed it.
@hevyStatsName = "Hevy Stats"

// Empty-string sentinel. All emptiness checks use explicit == @empty /
// != @empty comparisons: bare truthiness checks (if @x / if !@x) misbehave
// on device (found by device testing, Sep 30 2026).
@empty = ""

@inputTxt = "{ShortcutInput}"

// Hevy Stats' last action is its result dictionary, so run() returns a
// Dictionary here (or the handled-error dictionary).
@stats = run(@hevyStatsName, @inputTxt)

@errVal = getValue(@stats, "_error")
@errTxt = "{@errVal}"

@ob = "{"
@cb = "}"

if @errTxt != @empty {
    // Handled error from Hevy Stats: show it and pass it through unchanged.
    // (Hevy Stats already displayed its own error card.)
    show("{@stats}")
    @out = @stats
}

if @errTxt == @empty {
    @rnVal = getValue(@stats, "routineName")
    @routineName = "{@rnVal}"
    @wsDict = getValue(@stats, "workingSetsPerMuscleGroup")
    @volExDict = getValue(@stats, "volumeKgPerExercise")
    @volMuscleDict = getValue(@stats, "volumeKgPerMuscleGroup")
    @rmDict = getValue(@stats, "oneRepMaxKgPerExercise")
    @rWsVal = getValue(@stats, "routineWorkingSets")
    @rVolVal = getValue(@stats, "routineVolumeKg")
    @rDurVal = getValue(@stats, "routineDurationMinutes")

    @metricsJson = "["
    @sep = ""

    // Per muscle group: working sets + volume. Keys come from dictKeys()
    // (a real list), so the loop below is plain list iteration.
    @muscleKeys = dictKeys(@wsDict)
    for m in @muscleKeys {
        @safeM = replaceText("\\", "\\\\", @m)
        @safeM = replaceText("\"", "\\\"", @safeM)
        @wsVal = dictVal(@wsDict, @m)
        @wsTxt = "{@wsVal}"
        if @wsTxt != @empty {
            @rec = "{@ob}\"Form Name\": \"Hevy - Muscle Group\", \"Metric Name\": \"{@safeM} working sets\", \"Set Value\": {@wsTxt}, \"Increment\": false, \"Decrement\": false, \"Reset\": false, \"Increment Amount\": \"\"{@cb}"
            @metricsJson = "{@metricsJson}{@sep}{@rec}"
            @sep = ", "
        }
        @volVal = dictVal(@volMuscleDict, @m)
        @volTxt = "{@volVal}"
        if @volTxt != @empty {
            @rec = "{@ob}\"Form Name\": \"Hevy - Muscle Group\", \"Metric Name\": \"{@safeM} volume\", \"Set Value\": {@volTxt}, \"Increment\": false, \"Decrement\": false, \"Reset\": false, \"Increment Amount\": \"\"{@cb}"
            @metricsJson = "{@metricsJson}{@sep}{@rec}"
            @sep = ", "
        }
    }

    // Per exercise: volume + 1RM.
    @exKeys = dictKeys(@volExDict)
    for t in @exKeys {
        @safeT = replaceText("\\", "\\\\", @t)
        @safeT = replaceText("\"", "\\\"", @safeT)
        @volVal = dictVal(@volExDict, @t)
        @volTxt = "{@volVal}"
        if @volTxt != @empty {
            @rec = "{@ob}\"Form Name\": \"Hevy - Exercise\", \"Metric Name\": \"{@safeT} volume\", \"Set Value\": {@volTxt}, \"Increment\": false, \"Decrement\": false, \"Reset\": false, \"Increment Amount\": \"\"{@cb}"
            @metricsJson = "{@metricsJson}{@sep}{@rec}"
            @sep = ", "
        }
        @rmVal = dictVal(@rmDict, @t)
        @rmTxt = "{@rmVal}"
        if @rmTxt != @empty {
            @rec = "{@ob}\"Form Name\": \"Hevy - Exercise\", \"Metric Name\": \"{@safeT} 1RM\", \"Set Value\": {@rmTxt}, \"Increment\": false, \"Decrement\": false, \"Reset\": false, \"Increment Amount\": \"\"{@cb}"
            @metricsJson = "{@metricsJson}{@sep}{@rec}"
            @sep = ", "
        }
    }

    // Routine totals: working sets, volume, duration (when known).
    @safeR = replaceText("\\", "\\\\", @routineName)
    @safeR = replaceText("\"", "\\\"", @safeR)
    @rWsTxt = "{@rWsVal}"
    if @rWsTxt != @empty {
        @rec = "{@ob}\"Form Name\": \"Hevy - Routine\", \"Metric Name\": \"{@safeR} working sets\", \"Set Value\": {@rWsTxt}, \"Increment\": false, \"Decrement\": false, \"Reset\": false, \"Increment Amount\": \"\"{@cb}"
        @metricsJson = "{@metricsJson}{@sep}{@rec}"
        @sep = ", "
    }
    @rVolTxt = "{@rVolVal}"
    if @rVolTxt != @empty {
        @rec = "{@ob}\"Form Name\": \"Hevy - Routine\", \"Metric Name\": \"{@safeR} volume\", \"Set Value\": {@rVolTxt}, \"Increment\": false, \"Decrement\": false, \"Reset\": false, \"Increment Amount\": \"\"{@cb}"
        @metricsJson = "{@metricsJson}{@sep}{@rec}"
        @sep = ", "
    }
    @rDurTxt = "{@rDurVal}"
    if @rDurTxt != @empty {
        if @rDurTxt != "null" {
            @rec = "{@ob}\"Form Name\": \"Hevy - Routine\", \"Metric Name\": \"{@safeR} duration\", \"Set Value\": {@rDurTxt}, \"Increment\": false, \"Decrement\": false, \"Reset\": false, \"Increment Amount\": \"\"{@cb}"
            @metricsJson = "{@metricsJson}{@sep}{@rec}"
            @sep = ", "
        }
    }

    @metricsJson = "{@metricsJson}]"
    @metricsList = getDictionary(@metricsJson)
    // Show the JSON on manual runs so the records can be verified.
    show("{@metricsJson}")
    // The shortcut's output is the real List of Dictionaries, so callers
    // using Run Shortcut receive typed values (numbers stay numbers,
    // Increment/Decrement/Reset stay booleans).
    @out = @metricsList
}
